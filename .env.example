# Local SQL Server 2022 Developer default instance (MSSQLSERVER).
SQL_SERVER_HOST=NGUYENSON
SQL_SERVER_DATABASE=RetailAnalytics
SQL_SERVER_DRIVER=ODBC Driver 17 for SQL Server

# Supported values: windows or sql. Prefer Windows Authentication for local development.
SQL_SERVER_AUTH_MODE=windows
SQL_SERVER_TRUST_SERVER_CERTIFICATE=yes

# Used only when SQL_SERVER_AUTH_MODE=sql. Never store real credentials in this file.
SQL_SERVER_USERNAME=
SQL_SERVER_PASSWORD=
